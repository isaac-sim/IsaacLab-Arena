#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    prepend references = @https://huggingface.co/datasets/nvidia/simready-assets/resolve/653d91e182011f357cf1644013cc94ddf194d349/testingTool_oscilloscope_a01/simready_usd/sm_testingTool_oscilloscope_a01_01.usd@</RootNode>
    variants = {
        string PhysX = "Enabled"
    }
)
{
    bool physxArticulation:enabledSelfCollisions = 0

    over "Geometry"
    {
        over "body_01_obj_00" (
            prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysxContactReportAPI"]
            instanceable = false
        )
        {
            float physxContactReport:threshold = 0
            float physxRigidBody:sleepThreshold = 0
            over "body_01_mesh_00" (prepend apiSchemas = ["PhysxCollisionAPI"])
            {
                float physxCollision:contactOffset = 0.001
                float physxCollision:restOffset = 0
            }
        }

        over "button_01_obj_00" (
