        over "joint_button_01_joint_00" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 0.5
            float drive:linear:physics:maxForce = 3
            float drive:linear:physics:stiffness = 800
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
        }
    }

    def PhysicsFixedJoint "ArenaFixedBase"
    {
        rel physics:body1 = </Asset/Geometry/body_01_obj_00>
    }

    def "ArenaMaterials"
    {
        def Material "ScreenOff"
        {
            token outputs:surface.connect = </Asset/ArenaMaterials/ScreenOff/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 0.8
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }
