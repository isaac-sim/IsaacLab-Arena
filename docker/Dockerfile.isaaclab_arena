# syntax=docker/dockerfile:1
#
# Arena image installs dependencies before copying Arena sources, so source edits
# reuse the expensive dependency layers. cuRobo uses its cuda.core runtime backend,
# avoiding a CUDA toolkit and source-compilation stage.
#
# sim-base:       Isaac Sim, common system packages, and runtime permissions.
# isaaclab:       Isaac Lab checkout and its dependencies, on top of sim-base.
# arena-deps:     Arena dependencies, cuRobo, policy clients, and developer tools, on isaaclab.
# dev:            Arena source, editable install, shell setup, and entrypoint.

ARG BASE_IMAGE=nvcr.io/nvidia/isaac-sim:6.2.0

################################
# STAGE: sim-base
################################
FROM ${BASE_IMAGE} AS sim-base
USER root
ARG WORKDIR="/workspaces/isaaclab_arena"
ENV WORKDIR=${WORKDIR}
WORKDIR "${WORKDIR}"
RUN --mount=type=bind,source=docker/setup/install_system_deps.sh,target=/tmp/install_system_deps.sh \
    bash /tmp/install_system_deps.sh

# Pinned uv tooling used to construct the Isaac Lab environment. Follows Lab's pinned digest.
FROM ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff AS uv

################################
# STAGE: isaaclab
################################
FROM sim-base AS isaaclab
COPY --from=uv /uv /uvx /usr/local/bin/
ENV ISAACLAB_PATH=${WORKDIR}/submodules/IsaacLab
ENV TERM=xterm
ENV VIRTUAL_ENV=/opt/isaaclab-venv
ENV UV_PROJECT_ENVIRONMENT=${VIRTUAL_ENV}
ENV UV_PYTHON_PREFERENCE=only-system
ENV UV_HTTP_RETRIES=12
ENV PATH=${ISAACLAB_PATH}:${VIRTUAL_ENV}/bin:${PATH}
# Keep third-party dependency installation cached when only Isaac Lab source changes.
COPY submodules/IsaacLab/pyproject.toml \
    submodules/IsaacLab/uv.lock \
    ${ISAACLAB_PATH}/
COPY --parents submodules/IsaacLab/source/*/pyproject.toml ${WORKDIR}/
RUN --mount=type=bind,source=docker/setup/install_isaaclab.sh,target=/tmp/install_isaaclab.sh \
    --mount=type=cache,target=/root/.cache/uv \
    bash /tmp/install_isaaclab.sh dependencies
COPY submodules/IsaacLab ${ISAACLAB_PATH}
RUN --mount=type=bind,source=docker/setup/install_isaaclab.sh,target=/tmp/install_isaaclab.sh \
    --mount=type=cache,target=/root/.cache/uv \
    bash /tmp/install_isaaclab.sh workspace

################################
# STAGE: arena-deps
################################
FROM isaaclab AS arena-deps
ARG CUROBO_COMMIT=78fd485fa82d9b9a063fb4985e371814587e666a
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    "nvidia-curobo[cu13] @ git+https://github.com/NVlabs/curobo.git@${CUROBO_COMMIT}"
COPY ./submodules/Isaac-GR00T ${WORKDIR}/submodules/Isaac-GR00T
RUN --mount=type=bind,source=pyproject.toml,target=/tmp/arena-project/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/tmp/arena-project/uv.lock \
    --mount=type=bind,source=docker/setup/install_arena_deps.sh,target=/tmp/install_arena_deps.sh \
    bash /tmp/install_arena_deps.sh
RUN --mount=type=bind,source=docker/setup/install_gr00t_policy_client.sh,target=/tmp/install_gr00t_policy_client.sh \
    bash /tmp/install_gr00t_policy_client.sh
COPY --from=nvcr.io/nvidia/osmo/client:6.3.1 /osmo/osmo_cli_onedir/osmo /usr/local/osmo
RUN ln -sf /usr/local/osmo/osmo /usr/local/bin/osmo
RUN --mount=type=bind,source=docker/setup/install_dev_tools.sh,target=/tmp/install_dev_tools.sh \
    bash /tmp/install_dev_tools.sh

################################
# STAGE: dev
################################
FROM arena-deps AS dev
COPY *.* ${WORKDIR}/
# Preserve package directory names when copying multiple sources into one layer.
COPY --parents \
    isaaclab_arena \
    isaaclab_arena_cosmos \
    isaaclab_arena_curobo \
    isaaclab_arena_dreamzero \
    isaaclab_arena_g1 \
    isaaclab_arena_gr00t \
    isaaclab_arena_openpi \
    isaaclab_arena_vlm_agent \
    isaaclab_arena_environments \
    isaaclab_arena_examples \
    ${WORKDIR}/
RUN uv pip install --no-deps --no-build-isolation --editable "${WORKDIR}" && \
    chmod -R a+rwX "${VIRTUAL_ENV}"
ENV LW_API_ENDPOINT="https://api-dev.lightwheel.net"
RUN --mount=type=bind,source=docker/setup/configure_shell.sh,target=/tmp/configure_shell.sh \
    bash /tmp/configure_shell.sh
COPY docs ${WORKDIR}/docs
COPY docker/setup/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

# Default to the complete developer image.
FROM dev AS default
