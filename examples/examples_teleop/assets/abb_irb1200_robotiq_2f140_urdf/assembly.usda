    over "Physics"
    {
        def PhysicsFixedJoint "robotiq_mount_joint"
        {
            rel physics:body0 = </abb_irb1200_2f140/Geometry/base_link/link_1/link_2/link_3/link_4/link_5/link_6>
            rel physics:body1 = </abb_irb1200_2f140/Geometry/base_link/link_1/link_2/link_3/link_4/link_5/link_6/robotiq_mount/Geometry/robotiq_arg2f_base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
