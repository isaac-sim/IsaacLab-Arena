                                                        instanceable = false
                                                    )
                                                    {
                                                    }

                                                    over "robotiq_arg2f_140_inner_knuckle_1" (
                                                        instanceable = false
                                                    )
                                                    {
                                                    }
                                                }

                                                over "right_outer_knuckle"
                                                {
