#usda 1.0
(
    defaultPrim = "abb_irb1200_2f140"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "abb_irb1200_2f140" (
    prepend references = @../../../../isaaclab_arena/assets/robots/abb/irb1200_7_70/irb1200_7_70.usda@</abb_irb1200_7_70>
)
{
    over "Geometry"
    {
        over "base_link"
        {
            over "link_1"
            {
                over "link_2"
                {
                    over "link_3"
                    {
