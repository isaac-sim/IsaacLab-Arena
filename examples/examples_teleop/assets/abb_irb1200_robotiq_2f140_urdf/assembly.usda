                                    )
                                    {
                                        quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865476, 0)
                                        uniform token[] xformOpOrder = ["xformOp:orient"]

                                        over "Geometry"
                                        {
                                            over "robotiq_arg2f_base_link" (
                                                delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                                            )
