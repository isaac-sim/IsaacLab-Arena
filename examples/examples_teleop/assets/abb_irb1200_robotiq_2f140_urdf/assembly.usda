                                                    {
                                                        over "right_inner_finger"
                                                        {
                                                            over "robotiq_arg2f_140_inner_finger" (
                                                                instanceable = false
                                                            )
                                                            {
                                                            }

                                                            over "robotiq_arg2f_140_inner_finger_1" (
                                                                instanceable = false
                                                            )
                                                            {
                                                            }
                                                        }

                                                        over "robotiq_arg2f_140_outer_finger" (
                                                            instanceable = false
                                                        )
                                                        {
                                                        }

                                                        over "robotiq_arg2f_140_outer_finger_1" (
                                                            instanceable = false
                                                        )
                                                        {
                                                        }
                                                    }

                                                    over "robotiq_arg2f_140_outer_knuckle" (
                                                        instanceable = false
                                                    )
                                                    {
                                                    }

                                                    over "robotiq_arg2f_140_outer_knuckle_1" (
